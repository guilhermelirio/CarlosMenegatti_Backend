APP_NAME="Organization Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_IMAGE_TAG=latest
APP_PORT=8080

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=change-me

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

FILESYSTEM_DISK=public
MAIL_MAILER=log
BROADCAST_CONNECTION=log

BACKUP_NAME="${APP_NAME}"
BACKUP_DISKS=backups
BACKUP_ARCHIVE_PASSWORD=change-me-with-a-long-random-secret
BACKUP_ARCHIVE_ENCRYPTION=aes256
BACKUP_MAX_STORAGE_MB=5000
BACKUP_NOTIFICATION_MAIL_TO=
