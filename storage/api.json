{
    "openapi": "3.1.0",
    "info": {
        "title": "Laravel",
        "version": "0.0.1"
    },
    "servers": [
        {
            "url": "http://localhost/api"
        }
    ],
    "paths": {
        "/v1/login": {
            "post": {
                "operationId": "auth.login",
                "summary": "Authenticate an athlete and issue a Sanctum token",
                "tags": [
                    "Auth"
                ],
                "responses": {
                    "200": {
                        "description": "Login is not a resource creation -> 200 (Data responses default to 201).\n\n\n\n`AuthTokenData`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthTokenData"
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/v1/logout": {
            "post": {
                "operationId": "auth.logout",
                "summary": "Revoke the current access token",
                "tags": [
                    "Auth"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "const": "Sess\u00e3o encerrada."
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/me": {
            "get": {
                "operationId": "auth.me",
                "summary": "Profile of the authenticated athlete",
                "tags": [
                    "Auth"
                ],
                "responses": {
                    "200": {
                        "description": "`PlayerData`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PlayerData"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/me/daily-fees": {
            "get": {
                "operationId": "dailyFee.index",
                "summary": "List the authenticated athlete's daily fees (newest first)",
                "tags": [
                    "DailyFee"
                ],
                "responses": {
                    "200": {
                        "description": "`DataCollection`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/DataCollection"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/daily-fees/{dailyFee}/pix": {
            "post": {
                "operationId": "dailyFee.pix",
                "summary": "Start a Pix charge for one of the athlete's daily fees",
                "tags": [
                    "DailyFee"
                ],
                "parameters": [
                    {
                        "name": "dailyFee",
                        "in": "path",
                        "required": true,
                        "description": "The daily fee ID",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "`PaymentData`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PaymentData"
                                }
                            }
                        }
                    },
                    "403": {
                        "$ref": "#/components/responses/AuthorizationException"
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/sessions": {
            "get": {
                "operationId": "gameSession.index",
                "summary": "Upcoming sessions with the athlete's confirmation status",
                "tags": [
                    "GameSession"
                ],
                "responses": {
                    "200": {
                        "description": "`DataCollection`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/DataCollection"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/sessions/{gameSession}/confirm": {
            "post": {
                "operationId": "gameSession.confirm",
                "summary": "Confirm (or un-confirm) the athlete's presence in a session",
                "tags": [
                    "GameSession"
                ],
                "parameters": [
                    {
                        "name": "gameSession",
                        "in": "path",
                        "required": true,
                        "description": "The game session ID",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`GameSessionData`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/GameSessionData"
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/me/monthly-fees": {
            "get": {
                "operationId": "monthlyFee.index",
                "summary": "List the authenticated athlete's monthly fees (newest first)",
                "tags": [
                    "MonthlyFee"
                ],
                "responses": {
                    "200": {
                        "description": "`DataCollection`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/DataCollection"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/monthly-fees/{monthlyFee}/pix": {
            "post": {
                "operationId": "monthlyFee.pix",
                "summary": "Start a Pix charge for one of the athlete's monthly fees",
                "tags": [
                    "MonthlyFee"
                ],
                "parameters": [
                    {
                        "name": "monthlyFee",
                        "in": "path",
                        "required": true,
                        "description": "The monthly fee ID",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "`PaymentData`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PaymentData"
                                }
                            }
                        }
                    },
                    "403": {
                        "$ref": "#/components/responses/AuthorizationException"
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/me/payments": {
            "get": {
                "operationId": "payment.index",
                "summary": "Payment history for the authenticated athlete",
                "tags": [
                    "Payment"
                ],
                "responses": {
                    "200": {
                        "description": "`DataCollection`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/DataCollection"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/payments/{payment}": {
            "get": {
                "operationId": "payment.show",
                "summary": "Current status of a single payment (used to poll a Pix charge)",
                "tags": [
                    "Payment"
                ],
                "parameters": [
                    {
                        "name": "payment",
                        "in": "path",
                        "required": true,
                        "description": "The payment ID",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`PaymentData`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PaymentData"
                                }
                            }
                        }
                    },
                    "403": {
                        "$ref": "#/components/responses/AuthorizationException"
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/payments/{payment}/receipt": {
            "post": {
                "operationId": "payment.uploadReceipt",
                "tags": [
                    "Payment"
                ],
                "parameters": [
                    {
                        "name": "payment",
                        "in": "path",
                        "required": true,
                        "description": "The payment ID",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "receipt": {
                                        "type": "string",
                                        "format": "binary",
                                        "contentMediaType": "application/octet-stream",
                                        "maxLength": 5120
                                    }
                                },
                                "required": [
                                    "receipt"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`PaymentData`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PaymentData"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "An error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Error overview.",
                                            "example": "N\u00e3o foi poss\u00edvel guardar o comprovante."
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "$ref": "#/components/responses/AuthorizationException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            },
            "get": {
                "operationId": "payment.downloadReceipt",
                "tags": [
                    "Payment"
                ],
                "parameters": [
                    {
                        "name": "payment",
                        "in": "path",
                        "required": true,
                        "description": "The payment ID",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "403": {
                        "$ref": "#/components/responses/AuthorizationException"
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/webhooks/pix/{provider}/{secret}": {
            "post": {
                "operationId": "webhooks.pixWebhook",
                "tags": [
                    "PixWebhook"
                ],
                "parameters": [
                    {
                        "name": "provider",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "secret",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": ""
                    },
                    "401": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "const": "Assinatura inv\u00e1lida."
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "AuthTokenData": {
                "type": "object",
                "additionalProperties": {},
                "title": "AuthTokenData"
            },
            "DataCollection": {
                "type": "object",
                "additionalProperties": {},
                "title": "DataCollection"
            },
            "GameSessionData": {
                "type": "object",
                "additionalProperties": {},
                "title": "GameSessionData"
            },
            "PaymentData": {
                "type": "object",
                "additionalProperties": {},
                "title": "PaymentData"
            },
            "PlayerData": {
                "type": "object",
                "additionalProperties": {},
                "title": "PlayerData"
            }
        },
        "responses": {
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "ModelNotFoundException": {
                "description": "Not found",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "AuthorizationException": {
                "description": "Authorization error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            }
        }
    }
}